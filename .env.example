# 공통 필수: 실제 값은 저장소 밖의 환경파일 또는 프로세스 환경으로 주입합니다.
# 로컬 파일 위치와 실행 방법: docs/operations.md
ACCESS_SECRET=
REFRESH_SECRET=
CSRF_SECRET=
BASE_URL=http://localhost:8080
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# DB: 아래는 로컬 환경에서의 예시입니다. 운영에서는 세 항목 모두 실제 운영 값으로 설정합니다.
DB_URL=jdbc:mysql://localhost:3306/marigold?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# 로컬은 기본값 사용 가능. 운영에서는 실제 프론트엔드 HTTPS origin으로 변경합니다.
FRONTEND_ORIGIN=http://localhost:8000

# 운영 필수: local 프로필에서는 사용하지 않습니다.
UPLOAD_TOKEN_SECRET=
AWS_S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
