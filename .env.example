# 공통 필수: 실제 값은 저장소 밖의 환경파일 또는 프로세스 환경으로 주입합니다.
# 로컬 파일 위치와 실행 방법: docs/configuration.md
JWT_SECRET_KEY=
BASE_URL=http://localhost:8080
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# DB: 아래는 로컬 예시입니다. 운영에서는 세 항목 모두 실제 운영 값으로 설정합니다.
DB_URL=jdbc:mysql://localhost:3306/marigold?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# 로컬은 기본값 사용 가능. 운영에서는 실제 HTTPS origin으로 변경합니다.
FRONTEND_ORIGIN=http://localhost:8000

# 선택: 생략하면 application.yml의 기본값 사용. 빈 문자열로 설정하지 않습니다.
JWT_ACCESS_TOKEN_VALIDITY_SECONDS=3600
JWT_REFRESH_TOKEN_VALIDITY_SECONDS=86400

# 로컬 전용: 선택 항목. 서명 키를 별도로 지정하려면 아래 주석을 해제합니다.
LOCAL_STORAGE_ROOT=./uploads
LOCAL_STORAGE_PUBLIC_BASE_URL=http://localhost:8080
# LOCAL_STORAGE_SIGNING_SECRET=replace-with-local-signing-secret
LOCAL_STORAGE_VIEW_URL_TTL_MINUTES=60
LOCAL_STORAGE_DOWNLOAD_URL_TTL_MINUTES=10

# 운영 필수: local 프로필에서는 사용하지 않습니다.
AWS_S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
AWS_REGION=
