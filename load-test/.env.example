# .env.local 또는 .env.staging으로 복사하고 대상 환경에 맞게 값을 수정하세요. 지금 설정된 값들은 예시입니다.
# 실행 시 -EnvFile로 지정합니다. 예: .\run.ps1 smoke -EnvFile .env.local

# 서버 API 및 WebSocket 주소
BASE_URL=https://staging-api.example.com
WS_BASE_URL=wss://staging-api.example.com/ws/websocket
# API 요청 경로의 공통 접두사입니다.
API_VERSION=/api/v1

# -PrometheusRemoteWrite 사용 시 k6 지표를 전송할 주소입니다.
K6_PROMETHEUS_RW_SERVER_URL=http://localhost:9090/api/v1/write
# Prometheus로 전송할 응답시간 집계 항목입니다.
K6_PROMETHEUS_RW_TREND_STATS=p(90),p(95),p(99),avg,min,max

# 조회할 페이지 크기입니다. 전체 페이지 수는 seed 실행 후 출력값에 맞추세요.
LOAD_TEST_ADOPTION_PAGE_SIZE=10
LOAD_TEST_ADOPTION_TOTAL_PAGES=500
# fixed 방식에서 조회할 페이지 번호입니다. 첫 페이지는 0입니다.
LOAD_TEST_ADOPTION_FIXED_PAGE=0
# fixed: 고정 페이지, random: 균등 선택, weighted: 앞쪽 페이지를 더 자주 선택합니다.
LOAD_TEST_ADOPTION_PAGE_SELECTION=weighted
# 채팅 WebSocket 연결 유지 시간(초)입니다.
LOAD_TEST_CHAT_SESSION_SECONDS=60

# DB·저장소 profile의 실행 시간입니다. 예: 30s, 5m
LOAD_TEST_IO_DURATION=5m
# 사전 할당할 가상 사용자(VU) 수와 최대 VU 수입니다.
LOAD_TEST_IO_PRE_ALLOCATED_VUS=20
LOAD_TEST_IO_MAX_VUS=100
# 각 profile의 초당 반복 횟수입니다. 한 반복에서 여러 HTTP 요청이 발생할 수 있습니다.
LOAD_TEST_DB_READ_RATE=30
LOAD_TEST_DB_WRITE_RATE=5
LOAD_TEST_DB_MIXED_RATE=30
LOAD_TEST_STORAGE_UPLOAD_RATE=2
LOAD_TEST_STORAGE_MIXED_RATE=2
# 업로드할 이미지 수와 이미지 파일 경로입니다.
LOAD_TEST_STORAGE_IMAGE_COUNT=1
LOAD_TEST_STORAGE_IMAGE_PATH=../fixtures/storage/image-1mb.jpg
# 업로드 profile에서 생성한 게시글을 삭제할지 지정합니다.
LOAD_TEST_STORAGE_DELETE_CREATED=true

# seed·cleanup에서 사용할 테스트 전용 DB 접속 정보입니다. 운영 DB를 지정하지 마세요.
# -ConfirmTestDatabase는 실행 확인 옵션이며 운영 DB를 자동으로 차단하지 않습니다.
LOAD_TEST_DB_HOST=marigold-load-test.xxxxxxxxxxxx.ap-northeast-2.rds.amazonaws.com
LOAD_TEST_DB_PORT=3306
LOAD_TEST_DB_NAME=marigold_load_test
LOAD_TEST_DB_USERNAME=load_test_admin
LOAD_TEST_DB_PASSWORD=

# 생성할 사용자 수와 사용자 ID 시작 기준값입니다.
LOAD_TEST_SEED_USER_COUNT=50
LOAD_TEST_SEED_USER_ID_BASE=990000000000000000
# 생성할 채팅방 수와 채팅방·참여자 ID 시작 기준값입니다.
LOAD_TEST_SEED_CHAT_ROOM_COUNT=50
LOAD_TEST_SEED_CHAT_ROOM_ID_BASE=993000000000000000
LOAD_TEST_SEED_ROOM_PARTICIPANT_ID_BASE=994000000000000000
# 생성할 입양 게시글 수와 게시글당 댓글 수입니다.
LOAD_TEST_SEED_ADOPTION_POST_COUNT=5000
LOAD_TEST_SEED_COMMENTS_PER_POST=3

# 테스트 계정 이메일 구성입니다. 예: loadtest-user-000001@example.test
# cleanup은 이 접두사와 도메인에 해당하는 계정을 기준으로 연관 데이터를 삭제합니다.
LOAD_TEST_SEED_EMAIL_PREFIX=loadtest-user-
LOAD_TEST_SEED_EMAIL_DOMAIN=example.test
# k6 로그인용 평문 비밀번호와 seed에 저장할 대응 비밀번호 해시입니다.
# 두 값은 같은 비밀번호를 나타내야 합니다.
LOAD_TEST_LOGIN_PASSWORD=
LOAD_TEST_PASSWORD_HASH=
