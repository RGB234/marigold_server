%% 다른 도메인 테이블은 PK만 작성함. 전체 컬럼은 해당 도메인 ERD에 있다
erDiagram

    adoption_post {
        bigint id PK "AUTO_INCREMENT"
        datetime(6) created_at
        datetime(6) modified_at
        datetime(6) deleted_at "논리 삭제"
        bigint version "@Version 낙관적 락"
        bigint writer_id FK
        enum species "DOG|CAT|RODENTS|BIRDS|REPTILES|FISH|OTHER, 삭제 전 필수(ck)"
        enum sex "MALE|FEMALE|UNKNOWN|OTHER, 삭제 전 필수(ck)"
        enum neutering "YES|NO|UNKNOWN, 삭제 전 필수(ck)"
        varchar(255) area
        varchar(255) title
        text features
        int age "nullable"
        double weight "nullable"
        enum status "PROCEEDING|RESERVED|COMPLETED"
    }

    adoption_post_image {
        bigint id PK "AUTO_INCREMENT"
        datetime(6) created_at
        bigint storage_file_id FK,UK "uk_adoption_post_image_stored_file"
        bigint adoption_post_id FK
    }

    adoption_comment {
        bigint id PK "AUTO_INCREMENT"
        bigint version "@Version 낙관적 락"
        bigint adoption_post_id FK
        bigint writer_id FK
        bigint parent_id FK "대댓글, nullable"
        text content
        datetime(6) created_at
        datetime(6) modified_at
        datetime(6) deleted_at "논리 삭제"
    }

    adoption_comment_image {
        bigint id PK "AUTO_INCREMENT"
        datetime(6) created_at
        bigint storage_file_id FK,UK "uk_adoption_comment_image_stored_file"
        bigint adoption_comment_id FK
    }

    adoption_adopters {
        bigint id PK "AUTO_INCREMENT"
        bigint adoption_post_id FK,UK "uk_adoption_adopter_post"
        bigint adopter_id FK
        datetime(6) created_at
    }

    users {
        bigint id PK "user 도메인"
    }

    storage_file {
        bigint id PK "storage 도메인"
    }

    adoption_post ||--o{ adoption_post_image : "adoption_post_id"
    adoption_post ||--o{ adoption_comment : "adoption_post_id"
    adoption_post ||--o| adoption_adopters : "adoption_post_id"
    adoption_comment |o--o{ adoption_comment : "parent_id"
    adoption_comment ||--o{ adoption_comment_image : "adoption_comment_id"

    users ||--o{ adoption_post : "writer_id"
    users ||--o{ adoption_comment : "writer_id"
    users ||--o{ adoption_adopters : "adopter_id"

    storage_file ||--o| adoption_post_image : "storage_file_id"
    storage_file ||--o| adoption_comment_image : "storage_file_id"
